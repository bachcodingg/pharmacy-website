# Copy to .env for local development, or set with `fly secrets set` in
# production. Nothing here is secret by default - but fly.toml and the
# Dockerfile are committed, so anything that ever becomes secret belongs
# here and in Fly secrets, never in those.

# --- storage ---------------------------------------------------------------
# Root for everything mutable. Production points this at the mounted volume.
PHARMACY_DATA_DIR=./backend/data
# Individual overrides; each defaults to a path under PHARMACY_DATA_DIR.
PHARMACY_SEARCH_DB=./backend/data/app.db
PHARMACY_LOG_DIR=./backend/data/logs
PHARMACY_LEARNING_DIR=./backend/data/learning
# Derived search index. Belongs in the image, not the volume - it is rebuilt
# from the committed catalogue at build time.
PHARMACY_INDEX_DIR=./backend/index
PHARMACY_PRODUCTS_PATH=./backend/data/products.jsonl

# --- safety limits ---------------------------------------------------------
# Per-IP sliding-window limiting on auth, search and click endpoints.
PHARMACY_RATE_LIMIT_ENABLED=true
# Caps on caller-controlled input. The fuzzy corrector runs an edit distance
# against ~15k vocabulary forms, so query length is a cost the caller picks.
PHARMACY_MAX_QUERY_LENGTH=200
PHARMACY_MAX_LOG_FIELD_LENGTH=500

# --- development only ------------------------------------------------------
# Returns the password-reset token in the forgot-password response. This is an
# account-takeover vector: anyone who knows an email address can request the
# token and use it. Leave unset. NEVER set this in a deployed environment.
# PHARMACY_EXPOSE_RESET_TOKEN=1
